{
  "name": "@fence-estimator/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage.enabled --coverage.provider=v8 --coverage.reporter=text --coverage.exclude=**/dist/** --coverage.exclude=**/*.d.ts --coverage.exclude=**/index.ts --coverage.exclude=**/server.ts --coverage.exclude=**/scripts/** --coverage.thresholds.lines=47 --coverage.thresholds.functions=52 --coverage.thresholds.statements=47 --coverage.thresholds.branches=60",
    "migrate": "node scripts/migrate-postgres.mjs",
    "migrate:postgres": "node scripts/migrate-postgres.mjs",
    "backup:sqlite": "node scripts/backup-sqlite.mjs",
    "restore:sqlite": "node scripts/restore-sqlite.mjs",
    "recover:user": "node scripts/reset-user-password.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fence-estimator/contracts": "0.1.0",
    "@fence-estimator/geometry": "0.1.0",
    "@fence-estimator/rules-engine": "0.1.0",
    "@sentry/node": "^10.46.0",
    "better-sqlite3": "^11.10.0",
    "fastify": "^5.2.1",
    "@prometheus-io/client": "^0.16.1",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "pg-mem": "^3.0.14"
  }
}
